# --- BFF endpoint (the React client talks ONLY to this) ---
# Leave EMPTY for Vercel (same-origin Serverless Functions at /api/*).
# Set to http://localhost:8787 for local dev against the Express BFF.
VITE_API_BASE_URL=

# --- Informational (echoed in UI badges, NOT used for auth) ---
VITE_SF_ORG_URL=https://YOUR_INSTANCE.my.salesforce.com
VITE_AGENT_ID=
VITE_DEPLOYMENT_NAME=

# --- Behaviour ---
VITE_USE_MOCKS=false
VITE_DEFAULT_THEME=dark
VITE_APP_NAME=ReactSFAgent
VITE_APP_TAGLINE=Enterprise AI Workspace, powered by Agentforce
